generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  firstName    String?
  lastName     String?
  passwordHash String?
  authProvider String    @default("email")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  events    EventInbox[]
  logs      Log[]
  goals     Goal?
  favorites Favorite[]
  weights   Weight[]
  savedMeals SavedMeal[]
}

model EventInbox {
  eventId       String   @id
  userId        String
  deviceId      String
  type          String
  createdAt     DateTime
  schemaVersion Int
  payloadJson   Json
  receivedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Log {
  id         String   @id
  userId     String
  date       DateTime
  meal       String
  grams      Float
  kcal       Int
  protein    Float
  carbs      Float
  fat        Float
  productRef String?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Goal {
  userId        String  @id
  kcalTarget    Int
  proteinTarget Float
  carbTarget    Float
  fatTarget     Float
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@id([userId, productId])
}

model Weight {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  weightKg  Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Product {
  id                String   @id
  userId            String?
  name              String
  brand             String?
  barcode           String?
  nutrientsPer100g  Json
  imageUrl          String?
  source            String
  updatedAt         DateTime @updatedAt
}

model SavedMeal {
  id                String          @id
  userId            String
  name              String
  suggestedMealType String?
  updatedAt         DateTime
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             SavedMealItem[]

  @@index([userId, updatedAt])
}

model SavedMealItem {
  id              String    @id
  savedMealId     String
  productId       String
  productName     String
  grams           Float
  kcal            Int
  protein         Float
  carbs           Float
  fat             Float
  nutritionSource String
  sortIndex       Int
  savedMeal       SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)

  @@index([savedMealId, sortIndex])
}
